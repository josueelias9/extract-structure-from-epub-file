{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🟢 Worker: Celery Worker",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "args": [
                "-A", "src.infrastructure.queue.app:app",
                "worker",
                "--loglevel=info",
                "-Q", "summary_jobs",
                "--concurrency=1"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${command:python.interpreterPath}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/worker:${workspaceFolder}"
            }
        }
    ]
}
